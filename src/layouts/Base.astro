---
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
const siteName = "練習商事株式会社";
const pageTitle = title === siteName ? title : `${title}｜${siteName}`;
const path = Astro.url.pathname.replace(/\/$/, "") || "/";

const nav = [
  { href: "/", label: "トップ", en: "Home" },
  { href: "/safety", label: "労働安全", en: "Safety" },
];
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="robots" content="noindex" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{pageTitle}</title>
  </head>
  <body>
    <header class="site-header">
      <div class="container site-header__inner">
        <a href="/" class="logo" aria-label="練習商事 トップへ">
          <span class="logo__mark" aria-hidden="true"></span>
          <span class="logo__text">練習商事</span>
        </a>
        <nav aria-label="メインメニュー">
          <ul class="nav">
            {
              nav.map((item) => (
                <li>
                  <a
                    href={item.href}
                    class="nav__link"
                    aria-current={path === item.href ? "page" : undefined}
                  >
                    {item.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container site-footer__inner">
        <div>
          <p class="site-footer__name">練習商事株式会社</p>
          <p class="site-footer__address">〒000-0000 東京都練習区見本町1-2-3</p>
        </div>
        <ul class="site-footer__nav">
          {nav.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
        </ul>
      </div>
      <div class="container site-footer__bottom">
        <p>※ このサイトはWeb制作練習用の架空の企業サイトです。社名・住所・数値はすべて架空です。</p>
        <p class="site-footer__copy">© 2026 Renshu Shoji (fictional)</p>
      </div>
    </footer>
  </body>
</html>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 10;
    background: rgba(255, 255, 255, 0.94);
    backdrop-filter: blur(8px);
    border-bottom: 1px solid var(--gray-200);
  }

  .site-header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 68px;
  }

  .logo {
    display: flex;
    align-items: center;
    gap: 10px;
    text-decoration: none;
    font-weight: 700;
    font-size: 1.15rem;
    letter-spacing: 0.12em;
  }

  .logo__mark {
    width: 22px;
    height: 22px;
    background: var(--black);
    clip-path: polygon(0 0, 100% 0, 100% 100%, 50% 100%, 50% 50%, 0 50%);
  }

  .nav {
    display: flex;
    gap: clamp(16px, 4vw, 40px);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .nav__link {
    position: relative;
    text-decoration: none;
    font-size: 0.92rem;
    font-weight: 600;
    color: var(--gray-700);
    padding-block: 6px;
  }

  .nav__link:hover,
  .nav__link[aria-current="page"] {
    color: var(--black);
  }

  .nav__link[aria-current="page"]::after {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    bottom: -2px;
    height: 2px;
    background: var(--black);
  }

  .site-footer {
    background: var(--black);
    color: var(--gray-300);
    padding-top: 56px;
    font-size: 0.88rem;
  }

  .site-footer__inner {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 24px;
    padding-bottom: 40px;
    border-bottom: 1px solid #333;
  }

  .site-footer__name {
    color: var(--white);
    font-weight: 700;
    font-size: 1rem;
    margin-bottom: 4px;
  }

  .site-footer__nav {
    display: flex;
    gap: 24px;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .site-footer__nav a {
    text-decoration: none;
  }

  .site-footer__nav a:hover {
    color: var(--white);
  }

  .site-footer__bottom {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 8px 24px;
    padding-block: 20px 28px;
    font-size: 0.78rem;
    color: var(--gray-500);
  }
</style>
